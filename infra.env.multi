# infra.env.multi — consumer contract for vendor/fed-infra (multi profile)
#
# Mirrors infra.env (the single-profile contract): every value below is
# identical to infra.env except FED_CLUSTER_NAME (distinct host cluster name
# so `kind get clusters` never collides with the single profile's -- after
# Phase 4 nothing in code binds the literal name, teardown and fed-infra
# derive everything from this variable),
# FED_PROFILE, FED_COMPONENTS (adds `karmada` and `karmada-dashboard` -- the
# latter is the vendor/fed-infra component that now installs and exposes the
# Karmada Dashboard; install_multi_cluster_local.sh no longer inlines any of
# that itself, it only calls fed_dashboard_token afterward to print the login
# token), FED_MEMBER_COUNT/FED_MEMBER_PREFIX (new: how many Karmada member
# clusters to create and their name prefix -- FED_MEMBER_PREFIX is pinned by
# tests/test_multi_cluster_contract.py against the pipelines' parameter
# defaults), and FED_KARMADA_CONFIG (where fed-infra writes the Karmada
# apiserver kubeconfig; consumed by install_multi_cluster_local.sh, which
# rewrites and mounts it into the cluster as the karmada-kubeconfig Secret,
# and by fed_karmada_dashboard_install).
#
# FED_MEMBER_COUNT=2 matches config/config.json's "num_workers": 2. That
# value is no longer derived dynamically (see setup/install_multi_cluster_local.sh);
# if config.json's num_workers ever changes, update this to match by hand --
# automate_run.py separately reads config.json's num_workers directly, so
# this and that must be kept in sync manually.
FED_CLUSTER_NAME=multi-cluster-host
FED_NAMESPACE=kubeflow
FED_PROFILE=multi
FED_COMPONENTS=kfp,mlflow,temporal,karmada,karmada-dashboard
FED_KFP_VERSION=2.4.0
FED_KIND_WORKERS=0

FED_MEMBER_COUNT=2
FED_MEMBER_PREFIX=multi-cluster-member
FED_KARMADA_CONFIG=${HOME}/.karmada/karmada-apiserver.config

FED_S3_ENDPOINT=minio-service.kubeflow.svc.cluster.local:9000
FED_S3_ACCESS_KEY=minio
FED_S3_SECRET_KEY=minio123
FED_S3_BUCKET=mlflow-artifacts

FED_IMAGES="fed-twin-app:v1"

FED_NODEPORT_KFP=30080
FED_NODEPORT_MLFLOW=30500
FED_NODEPORT_MINIO_API=30900
FED_NODEPORT_MINIO_CONSOLE=30901
FED_HOSTPORT_KFP=8080
FED_HOSTPORT_MLFLOW=5050
FED_HOSTPORT_MINIO_API=9000
FED_HOSTPORT_MINIO_CONSOLE=9001
